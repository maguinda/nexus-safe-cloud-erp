# Copia este archivo a .env (que Git ignora) y cambia los valores.
# Solo letras y números en las contraseñas (el script de inicio las usa dentro de SQL).
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=changemeadmin1
DB_IDENTITY_PASSWORD=changemeidentity1
DB_PROJECTS_PASSWORD=changemeprojects1
DB_BILLING_PASSWORD=changemebilling1
DB_ANALYTICS_PASSWORD=changemeanalytics1
DB_NOTIFICATIONS_PASSWORD=changemenotifications1
RABBITMQ_USER=erp
RABBITMQ_PASSWORD=changemerabbit1

# Solo desarrollo: carga usuarios y datos de demostración al arrancar los contenedores.
SEED_DEMO=true
DEMO_PASSWORD=demo-password-1

# Opcional: asesor de decisiones con IA (pantalla del gerente). Sin llave sigue funcionando con reglas. Pon aquí tu llave de la API de Anthropic; no la pegues en chats ni en commits.
# Renovación de sesión: minutos que dura el token de renovación sin usarse, tope absoluto de la sesión en horas y, con HTTPS, la cookie Secure.
REFRESH_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
COOKIE_SECURE=false
# Clave de servicio de los emisores de telemetría (sensores, simulador): POST /telemetry/readings. Mínimo 32 caracteres; vacía = la ingesta responde 503.
# Generarla con: openssl rand -hex 24  (nunca se sube a Git; el simulador la lee de aquí)
INGEST_KEY=
ANTHROPIC_API_KEY=
ADVISOR_MODEL=claude-sonnet-5-5
# Factura electrónica de PRUEBA (sandbox, SIN validez legal). Solo existe el ambiente `sandbox`: pedir `production` impide que billing arranque, porque no hay proveedor tecnológico
# autorizado por la DIAN, certificado de firma ni habilitación conectados. Los datos del emisor son FICTICIOS; la clave técnica es de prueba (el CUFE no es oficial).
EINVOICE_ENVIRONMENT=sandbox
EINVOICE_SUPPLIER_NAME="Velocity Softworks (sandbox)"
EINVOICE_SUPPLIER_NIT=900123456
EINVOICE_SUPPLIER_EMAIL=facturacion@velocity.example
EINVOICE_SUPPLIER_ADDRESS="Calle 1 No 2-3"
EINVOICE_SUPPLIER_CITY=Medellín
EINVOICE_TECHNICAL_KEY=sandbox-technical-key-not-official
EINVOICE_VERIFY_URL_BASE=http://localhost:8080/sandbox/einvoice/verify?documentkey=
# Balanceador o CDN delante del gateway (CIDR separados por comas, p. ej. 10.0.0.0/8). Solo esas direcciones pueden decir la IP del cliente en X-Forwarded-For;
# sin esto, detrás de un balanceador todas las personas comparten la misma bolsa de límite de peticiones. Vacío = no se confía en ninguna (la demo local).
TRUSTED_PROXIES=
