# PRODUCCIÓN. Copia a .env en el servidor (Git lo ignora) y cambia TODOS los valores. ./scripts/prod-preflight.sh revisa que no quede nada de ejemplo.
# Contraseñas: solo letras y números (el script de inicio las usa dentro de SQL). Genera cada una con:  openssl rand -hex 16
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
DB_IDENTITY_PASSWORD=
DB_PROJECTS_PASSWORD=
DB_BILLING_PASSWORD=
DB_ANALYTICS_PASSWORD=
DB_NOTIFICATIONS_PASSWORD=
DB_CAPACITY_PASSWORD=
DB_OPERATIONS_PASSWORD=
DB_PROCUREMENT_PASSWORD=
RABBITMQ_USER=erp
RABBITMQ_PASSWORD=

# En producción NUNCA hay datos ni usuarios de demostración. El primer gerente se crea con ./scripts/create-admin.sh.
SEED_DEMO=false
COOKIE_SECURE=true
REFRESH_IDLE_MINUTES=30
SESSION_MAX_HOURS=8

# Clave de los emisores de telemetría (sensores). Mínimo 32 caracteres:  openssl rand -hex 24
INGEST_KEY=

# El dominio de la empresa y el correo para el certificado HTTPS (Let's Encrypt).
DOMAIN=
ACME_EMAIL=

# El servidor HTTPS (Caddy) corre en la misma máquina: es el único que puede decir la IP del cliente.
TRUSTED_PROXIES=127.0.0.1/32

# Opcional: asesor con IA. Sin llave funciona con reglas.
ANTHROPIC_API_KEY=
ADVISOR_MODEL=claude-sonnet-5-5

# Factura electrónica: SOLO existe el modo de prueba (sandbox, SIN validez legal). Para vender hace falta un proveedor tecnológico autorizado por la DIAN.
EINVOICE_ENVIRONMENT=sandbox
EINVOICE_SUPPLIER_NAME=
EINVOICE_SUPPLIER_NIT=
EINVOICE_SUPPLIER_EMAIL=
EINVOICE_SUPPLIER_ADDRESS=
EINVOICE_SUPPLIER_CITY=
EINVOICE_TECHNICAL_KEY=
EINVOICE_VERIFY_URL_BASE=
