// Base de Procurement & Inventory: proveedores, pedidos de compra, existencias y las sugerencias que salen de los avisos de sensores.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Supplier {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  /// fixed (proveedor fijo) o tender (por licitación).
  kind      String
  terms     String   @default("")
  /// Solo licitaciones: referencia y vigencia.
  tenderRef  String?  @map("tender_ref")
  validUntil DateTime? @map("valid_until") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  orders    PurchaseOrder[]

  @@map("suppliers")
}

model Item {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  /// equipment (equipo que entra a la flota) o spare (repuesto).
  kind      String
  /// Medidas de sensor (TEMP, HUMIDITY…) para las que sirve: con ellas se sugiere cuando un sensor se pone en alerta.
  forKinds  String[] @map("for_kinds")
  onHand    Int      @default(0) @map("on_hand")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  orders    PurchaseOrder[]

  @@map("items")
}

model PurchaseOrder {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// PO-0001, PO-0002… (la base numera, sin huecos por reintentos de la aplicación).
  number       Int       @unique @default(autoincrement())
  supplierId   String    @map("supplier_id") @db.Uuid
  itemId       String    @map("item_id") @db.Uuid
  quantity     Int
  unitPriceCop Int       @map("unit_price_cop")
  totalCop     Int       @map("total_cop")
  status       String    @default("ordered")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  receivedAt   DateTime? @map("received_at") @db.Timestamptz(6)
  supplier     Supplier  @relation(fields: [supplierId], references: [id])
  item         Item      @relation(fields: [itemId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@map("purchase_orders")
}

model ProcessedEvent {
  eventId     String   @id @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@map("processed_events")
}

/// Avisos de sensores (ThresholdBreached) que llegaron: sirven para sugerir repuestos. Solo se guardan los últimos.
model AlertSuggestion {
  id          Int      @id @default(autoincrement())
  eventId     String   @unique @map("event_id") @db.Uuid
  deviceName  String   @map("device_name")
  location    String
  readingKind String   @map("reading_kind")
  status      String
  value       Float
  unit        String
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(6)

  @@index([occurredAt(sort: Desc)])
  @@map("alert_suggestions")
}

model OutboxEvent {
  id          String    @id @db.Uuid
  aggregateId String    @map("aggregate_id")
  type        String
  routingKey  String    @map("routing_key")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  @@unique([aggregateId, type])
  @@index([publishedAt])
  @@map("outbox_events")
}

/// Historial de movimientos de stock (solo se agrega).
model StockMovement {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId      String   @map("item_id") @db.Uuid
  itemName    String   @map("item_name")
  delta       Int
  onHandAfter Int      @map("on_hand_after")
  source      String
  reason      String
  actor       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([itemId, createdAt(sort: Desc)])
  @@map("stock_movements")
}

/// Conteo físico del inventario. Solo uno abierto a la vez (índice único parcial en la base).
model StockCount {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number    Int      @unique @default(autoincrement())
  status    String   @default("open")
  openedBy  String?  @map("opened_by")
  openedAt  DateTime @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedBy  String?  @map("closed_by")
  closedAt  DateTime? @map("closed_at") @db.Timestamptz(6)
  lines     StockCountLine[]

  @@map("stock_counts")
}

model StockCountLine {
  countId      String   @map("count_id") @db.Uuid
  itemId       String   @map("item_id") @db.Uuid
  itemName     String   @map("item_name")
  expected     Int
  counted      Int?
  countedBy    String?  @map("counted_by")
  countedAt    DateTime? @map("counted_at") @db.Timestamptz(6)
  appliedDelta Int?     @map("applied_delta")
  count        StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@id([countId, itemId])
  @@map("stock_count_lines")
}

/// Qué vende cada proveedor (precio de referencia y plazo de entrega en días).
model SupplierItem {
  supplierId  String @map("supplier_id") @db.Uuid
  itemId      String @map("item_id") @db.Uuid
  refPriceCop Int    @map("ref_price_cop")
  leadDays    Int    @map("lead_days")

  @@id([supplierId, itemId])
  @@map("supplier_items")
}

/// Un equipo pasó de «en bodega» a «instalado» (INS-0001…).
model EquipmentInstall {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number      Int      @unique @default(autoincrement())
  itemId      String   @map("item_id") @db.Uuid
  itemName    String   @map("item_name")
  installedBy String?  @map("installed_by")
  installedAt DateTime @default(now()) @map("installed_at") @db.Timestamptz(6)

  @@map("equipment_installs")
}
