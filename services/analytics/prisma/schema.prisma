// Base de Analytics: SOLO modelos de lectura armados con eventos. Ningún otro servicio la lee ni la escribe.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTA (2026-10-29): la telemetría y el inventario de red viven en el servicio operations; la migración 0007 eliminó sus tablas de esta base.
enum InvoiceStatus {
  draft
  issued
}

/// Una fila por hito. Cada tipo de evento escribe sus propios campos y la fusión no depende del orden de llegada.
model MilestoneFact {
  milestoneId   String         @id @map("milestone_id")
  projectId     String?        @map("project_id")
  projectName   String         @map("project_name")
  milestoneName String         @map("milestone_name")
  /// Subtotal aprobado (antes de IVA).
  amountCop     Int            @map("amount_cop")
  /// Cuándo se creó el hito (evento MilestoneCreated); null en los anteriores a ese evento. Sin approvedAt = pendiente.
  createdAt     DateTime?      @map("created_at")
  approvedBy    String?        @map("approved_by")
  approvedAt    DateTime?      @map("approved_at")
  invoiceNumber String?        @map("invoice_number")
  invoiceStatus InvoiceStatus? @map("invoice_status")
  taxCop        Int?           @map("tax_cop")
  totalCop      Int?           @map("total_cop")
  draftedAt     DateTime?      @map("drafted_at")
  issuedAt      DateTime?      @map("issued_at")
  /// Cuándo se supo que la factura venció (evento OverdueDetected) y cuántos días llevaba entonces; null si no ha vencido.
  overdueAt     DateTime?      @map("overdue_at")
  overdueDays   Int?           @map("overdue_days")
  /// Lo pagado en total contra su factura (evento PaymentReceived: el máximo visto).
  paidCop       Int            @default(0) @map("paid_cop")
  updatedAt     DateTime       @default(now()) @map("updated_at")

  @@index([projectName])
  @@map("milestone_facts")
}

/// Lista de actividad reciente: cuándo ocurrió cada evento y cuándo llegó (de ahí sale el «retraso» del tablero).
model ActivityEntry {
  eventId    String   @id @map("event_id") @db.Uuid
  kind       String
  message    String
  occurredAt DateTime @map("occurred_at")
  receivedAt DateTime @default(now()) @map("received_at")

  @@index([occurredAt])
  @@map("activity_entries")
}

/// Bandeja de entrada: eventos ya procesados. Un evento repetido se ignora.
model ProcessedEvent {
  eventId     String   @id @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_events")
}

/// Asignaciones (eventos de Technical Capacity) para calcular la rentabilidad por proyecto.
model AllocationFact {
  allocationId String   @id @map("allocation_id") @db.Uuid
  projectName  String   @map("project_name")
  engineerName String   @map("engineer_name")
  percent      Int
  periodStart  DateTime @map("period_start") @db.Date
  periodEnd    DateTime @map("period_end") @db.Date
  dailyCostCop Int?     @map("daily_cost_cop")
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(6)

  @@index([projectName])
  @@map("allocation_facts")
}

model RemovedAllocationMark {
  allocationId String   @id @map("allocation_id") @db.Uuid
  removedAt    DateTime @default(now()) @map("removed_at") @db.Timestamptz(6)

  @@map("removed_allocation_marks")
}

/// Bitácora de auditoría (solo se agrega): quién, qué y cuándo de cada evento del bus.
model AuditEntry {
  eventId       String   @id @map("event_id") @db.Uuid
  type          String
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(6)
  receivedAt    DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  actor         String?
  summary       String
  correlationId String   @map("correlation_id")

  @@index([type])
  @@map("audit_entries")
}

/// Un movimiento de dinero (solo agregar): entra lo que pagan los clientes; sale la nómina y lo que se paga a proveedores.
model CashEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String   @unique @map("event_id") @db.Uuid
  entryDate   DateTime @map("entry_date") @db.Date
  direction   String
  category    String
  amountCop   BigInt   @map("amount_cop")
  ref         String
  projectName String?  @map("project_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entryDate])
  @@index([projectName])
  @@map("cash_entries")
}

/// Lo que se cotizó de un proyecto aprobado: precio, costo y margen.
model QuoteFact {
  quoteNumber String   @id @map("quote_number")
  eventId     String   @unique @map("event_id") @db.Uuid
  projectId   String   @map("project_id")
  projectName String   @map("project_name")
  priceCop    Int      @map("price_cop")
  costCop     Int      @map("cost_cop")
  marginPct   Int      @map("margin_pct")
  approvedBy  String   @map("approved_by")
  approvedAt  DateTime @map("approved_at") @db.Timestamptz(6)

  @@index([projectName])
  @@map("quote_facts")
}
