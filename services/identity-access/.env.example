# Copia a .env (ignorado por Git). La contraseña de la base viene de ../../.env (DB_IDENTITY_PASSWORD).
DATABASE_URL=postgresql://identity:changemeidentity1@localhost:5432/identity
JWT_PRIVATE_KEY_PATH=../../infra/keys/jwt-private.pem
JWT_ISSUER=identity-access
JWT_AUDIENCE=erp-api
JWT_TTL_SECONDS=900
PORT=4101
# Solo para el seed de usuarios de demostración:
DEMO_PASSWORD=demo-password-1
# Eventos UserCreated y RoleChanged (outbox). Sin RABBITMQ_URL Identity funciona igual y no publica nada; los eventos esperan en la tabla.
RABBITMQ_URL=amqp://erp:changemerabbit1@localhost:5672
OUTBOX_POLL_MS=500
RELAY_ENABLED=true
