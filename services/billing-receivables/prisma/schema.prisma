generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InvoiceStatus {
  draft
  issued
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  /// INV-0001... generado con la secuencia invoice_number_seq (ver la migración)
  number        String        @unique
  /// A lo sumo una factura por hito: invariante a nivel de base de datos.
  milestoneId   String        @unique @map("milestone_id")
  projectName   String        @map("project_name")
  milestoneName String        @map("milestone_name")
  /// Subtotal (el monto del hito). IVA y total se calculan con la regla de dominio y la base verifica que cuadren.
  amountCop     Int           @map("amount_cop")
  taxCop        Int           @map("tax_cop")
  totalCop      Int           @map("total_cop")
  status        InvoiceStatus @default(draft)
  createdAt     DateTime      @default(now()) @map("created_at")
  issuedAt      DateTime?     @map("issued_at")
  issuedBy      String?       @map("issued_by")
  sourceEventId String?       @map("source_event_id") @db.Uuid
  /// Trazabilidad hito -> factura: quién aprobó y cuándo (vienen en el evento).
  approvedBy    String?       @map("approved_by")
  approvedAt    DateTime?     @map("approved_at")

  @@index([createdAt])
  @@map("invoices")
}

/// Bandeja de entrada: eventos ya procesados. Un evento repetido se ignora.
model ProcessedEvent {
  eventId     String   @id @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_events")
}

/// Bandeja de salida: los eventos de billing se guardan aquí EN LA MISMA transacción que el cambio y un relay los publica
/// a RabbitMQ después. Así un fallo no deja una factura sin aviso ni un aviso de algo que no se guardó.
model OutboxEvent {
  id          String    @id @db.Uuid
  /// Número de la factura (INV-0103).
  aggregateId String    @map("aggregate_id")
  type        String
  routingKey  String    @map("routing_key")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  /// Defensa extra: nunca dos eventos del mismo tipo para la misma factura.
  @@unique([aggregateId, type])
  @@index([publishedAt])
  @@map("outbox_events")
}
