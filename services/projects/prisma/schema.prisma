generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MilestoneStatus {
  pending
  approved
}

model Project {
  id         String      @id
  name       String
  client     String
  milestones Milestone[]

  @@map("projects")
}

model Milestone {
  id         String          @id
  projectId  String          @map("project_id")
  name       String
  amountCop  Int             @map("amount_cop")
  status     MilestoneStatus @default(pending)
  approvedAt DateTime?       @map("approved_at")
  approvedBy String?         @map("approved_by")
  project    Project         @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@map("milestones")
}

/// Evento guardado en la misma transacción que el cambio de negocio; un relay lo publica después.
model OutboxEvent {
  id          String    @id @db.Uuid
  aggregateId String    @map("aggregate_id")
  type        String
  routingKey  String    @map("routing_key")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  /// Defensa extra: nunca dos eventos del mismo tipo para el mismo hito.
  @@unique([aggregateId, type])
  @@index([publishedAt])
  @@map("outbox_events")
}

/// Quién trabaja en cada proyecto (evento EngineerAllocated). Se enlaza con `projects.name` por valor.
model ProjectTeamMember {
  allocationId String   @id @map("allocation_id") @db.Uuid
  engineerName String   @map("engineer_name")
  projectName  String   @map("project_name")
  percent      Int
  periodStart  DateTime @map("period_start") @db.Date
  periodEnd    DateTime @map("period_end") @db.Date
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(6)

  @@index([projectName])
  @@map("project_team")
}

/// Asignaciones anunciadas como quitadas (AllocationRemoved): evitan que una asignación reaparezca si los avisos llegan en desorden.
model RemovedAllocation {
  allocationId String   @id @map("allocation_id") @db.Uuid
  removedAt    DateTime @default(now()) @map("removed_at") @db.Timestamptz(6)

  @@map("removed_allocations")
}

/// Cotización de ventas: proyecto con hitos y costos. Los totales NO se guardan: se calculan siempre de las líneas.
model Quote {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number       Int      @unique @default(autoincrement())
  client       String
  projectName  String   @map("project_name")
  /// draft, pending (esperando a gerencia), approved o rejected.
  status       String   @default("draft")
  marginPct    Int      @default(25) @map("margin_pct")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  submittedAt  DateTime? @map("submitted_at") @db.Timestamptz(6)
  decidedBy    String?  @map("decided_by")
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote String?  @map("decision_note")
  /// El proyecto que nació al aprobar.
  projectId    String?  @map("project_id")
  milestones   QuoteMilestone[]

  @@index([createdBy])
  @@map("quotes")
}

model QuoteMilestone {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId  String @map("quote_id") @db.Uuid
  position Int
  name     String
  quote    Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  lines    QuoteLine[]

  @@unique([quoteId, position])
  @@map("quote_milestones")
}

model QuoteLine {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  milestoneId String @map("milestone_id") @db.Uuid
  position    Int
  /// materials, supplies o labor.
  category    String
  description String
  quantity    Int
  unitCostCop Int    @map("unit_cost_cop")
  /// De dónde salió el precio: un artículo del catálogo o un cargo (informativo; Projects no lo verifica contra otro servicio).
  ref         String?
  milestone   QuoteMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([milestoneId, position])
  @@map("quote_lines")
}
