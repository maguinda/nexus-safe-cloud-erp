// Base de Technical Capacity: ingenieros y sus asignaciones por período. Ningún otro servicio la lee ni la escribe.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Engineer {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  role           String
  skills         String[]
  certifications String[]
  /// Cargo del catálogo fijo (software_engineer, cloud_devops_engineer, security_engineer, network_engineer, tech_lead, field_technician, support_technician).
  position       String
  /// engineer o technician: lo deriva el cargo (la base lo comprueba).
  kind           String
  /// Sueldo MENSUAL de nómina en pesos (lo escribe gerencia); null = sin sueldo todavía.
  monthlySalaryCop Int?       @map("monthly_salary_cop")
  /// Costo por día hábil = sueldo ÷ 22, redondeado. Lo calcula el servicio y lo comprueba la base; Analytics lo usa para la rentabilidad.
  dailyCostCop   Int?         @map("daily_cost_cop")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  allocations    Allocation[]

  @@map("engineers")
}

/// Un porcentaje de la jornada de un ingeniero, del día start al end (los dos incluidos).
model Allocation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  engineerId    String   @map("engineer_id") @db.Uuid
  projectName   String   @map("project_name")
  percent       Int
  startDate     DateTime @map("start_date") @db.Date
  endDate       DateTime @map("end_date") @db.Date
  /// Se aceptó pasando de 100 % a propósito (decisión de gerencia).
  overAllocated Boolean  @default(false) @map("over_allocated")
  /// project (proyecto: hitos, instalaciones nuevas) o maintenance (una orden de trabajo: preventivo, correctivo, inspección).
  kind          String   @default("project")
  /// La orden de trabajo (id en Operations) de la que nace una asignación de mantenimiento; única.
  workOrderId   String?  @unique @map("work_order_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  engineer      Engineer @relation(fields: [engineerId], references: [id], onDelete: Cascade)

  @@index([engineerId, startDate, endDate])
  @@map("allocations")
}

/// Evento guardado en la misma transacción que el cambio de negocio; un relay lo publica después.
model OutboxEvent {
  id          String    @id @db.Uuid
  aggregateId String    @map("aggregate_id")
  type        String
  routingKey  String    @map("routing_key")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  /// Nunca dos eventos del mismo tipo para la misma asignación.
  @@unique([aggregateId, type])
  @@index([publishedAt])
  @@map("outbox_events")
}

/// Tarifa de referencia por cargo: sueldo mensual estimado del mercado. El costo por día hábil se calcula (sueldo ÷ 22).
model PositionRate {
  position         String   @id
  monthlySalaryCop Int      @map("monthly_salary_cop")
  note             String
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  updatedBy        String?  @map("updated_by")

  @@map("position_rates")
}
